                64
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "K2vnG",
                  "name": "ScrollArea",
                  "width": "fill_container",
                  "height": "fill_container",
                  "layout": "vertical",
                  "gap": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "BpX8J",
                      "name": "ChTitle",
                      "fill": "$v:--foreground",
                      "content": "Chapter 1",
                      "fontFamily": "Inter",
                      "fontSize": 32,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "v2y56k",
                      "name": "DecorLine",
                      "width": 60,
                      "height": 4,
                      "fill": "$v:--primary",
                      "cornerRadius": 2
                    },
                    {
                      "type": "text",
                      "id": "Xd2Ef",
                      "name": "Para1",
                      "fill": "#2D2D2D",
                      "content": "In my younger and more vulnerable years my father gave me some advice that I've been turning over in my mind ever since.",
                      "fontFamily": "Inter",
                      "fontSize": 16
                    },
                    {
                      "type": "text",
                      "id": "R0vq2",
                      "name": "Para2",
                      "fill": "#2D2D2D",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "He didn't say any more, but we've always been unusually communicative in a reserved way, and I understood that he meant a great deal more than that. In consequence, I'm inclined to reserve all judgments, a habit that has opened up many curious natures to me and also made me the victim of not a few veteran bores.",
                      "fontFamily": "Inter",
                      "fontSize": 16
                    },
                    {
                      "type": "text",
                      "id": "v2DJGj",
                      "name": "Para3",
                      "fill": "#2D2D2D",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The abnormal mind is quick to detect and attach itself to this quality when it appears in a normal person, and so it came about that in college I was unjustly accused of being a politician, because I was privy to the secret griefs of wild, unknown men.",
                      "fontFamily": "Inter",
                      "fontSize": 16
                    },
                    {
                      "type": "frame",
                      "id": "iwqkX",
                      "name": "Spacer2",
                      "width": "fill_container",
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "z8KI6",
                      "name": "PageIndicator",
                      "fill": "$v:--muted-foreground",
                      "content": "— Page 12 of 180 —",
                      "textAlign": "center",
                      "fontFamily": "Inter",
                      "fontSize": 14
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
